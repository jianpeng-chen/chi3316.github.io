---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { projects } from '../data/projects';
import { withBase } from '../lib/paths';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);
const date = (value: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .format(value)
    .replaceAll('/', '.');
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-heading">
        <p class="section-label">A CURIOUS MIND. A BUILDER AT HEART.</p><h1 id="hero-title">
          STAY CURIOUS.<br />BUILD <span class="outline">REAL</span><span class="orange">.</span>
        </h1>
      </div><div class="hero-side">
        <p class="hero-greeting">你好，我是<span>迟迟</span>。<span class="wave">✦</span></p><p>
          AI 应用开发工程师，也是永远好奇的建造者。<br />把 Agent、数据与自动化，<br
          />变成解决真实问题的产品。
        </p><div class="hero-actions">
          <a class="button primary" href="#quests">探索我的项目 <span>↗</span></a><a
            class="text-link"
            href={withBase('/about/')}>认识这位玩家 <span>↗</span></a>
        </div><p class="hero-note"><i></i> SHANGHAI, CHINA · ALWAYS BUILDING</p>
      </div>
    </div>
    <div class="hero-world">
      <img
        class="world-image"
        src={withBase('/worlds/valley.svg')}
        width="960"
        height="380"
        fetchpriority="high"
        alt="夕阳照亮像素山谷，河流穿过松林，远处是遗迹，近处的玩家正站在营火旁"
      /><div class="world-topline pixel-label">
        <span><i></i> WORLD 01 / THE BUILDER’S VALLEY</span><span>EST. 2024 — STILL EXPLORING</span>
      </div><a class="player-card" href={withBase('/about/')}
        ><div class="player-card-label pixel-label"><span>PLAYER PROFILE</span><span>↗</span></div><div
          class="player-card-main"
        >
          <div class="player-avatar"><PixelIcon kind="player" /></div><div>
            <h2>迟迟 <span>/ CHICHI</span></h2><p>AI APPLICATION ENGINEER</p>
          </div>
        </div><div class="player-mission">
          <span>当前主线</span><strong>让 AI 真正进入业务工作流。</strong>
        </div><div class="player-skills">
          <span>AI</span><span>AGENT</span><span>DATA</span><span>BUILD</span>
        </div><div class="player-card-foot pixel-label">
          <span>STATUS: LEARNING BY BUILDING</span><span>✦</span>
        </div></a
      ><div class="world-caption">
        <span>⌖</span><div>THE VALLEY OF POSSIBILITY<small>每一个好问题，都是一段新冒险的起点。</small></div>
      </div><a class="map-link pixel-label" href="#quests">EXPLORE THE MAP <span>↓</span></a><span
        class="world-corner pixel-label">PRESS ON. STAY CURIOUS.</span>
    </div>
    <div
      class="skill-marquee"
      aria-label="AI Engineering、Agent Systems、Data Products、Open Source、Always Curious"
    >
      <span>AI ENGINEERING</span><PixelIcon /><span>AGENT SYSTEMS</span><PixelIcon /><span>DATA PRODUCTS</span
      ><PixelIcon /><span>OPEN SOURCE</span><PixelIcon /><span>ALWAYS CURIOUS</span><PixelIcon />
    </div>
  </section>
  <section class="projects-section" id="quests">
    <div class="shell">
      <p class="section-label">01 / THE QUEST LOG</p><div class="section-heading">
        <h2>想法不止于想。<br /><span class="heading-subtle">这是我的实战记录。</span></h2><a
          class="text-link"
          href={withBase('/projects/')}>打开项目图鉴 <span>↗</span></a>
      </div><div class="project-list">{projects.map((project) => <ProjectCard project={project} />)}</div><div
        class="section-foot pixel-label"
      >
        <span>3 QUESTS / REAL PROBLEMS / REAL EXPERIENCE</span><span>每一次交付，都让下一次更好。</span>
      </div>
    </div>
  </section>
  <section class="builder-section">
    <div class="builder-world">
      <img
        src={withBase('/worlds/forest.svg')}
        width="900"
        height="550"
        loading="lazy"
        alt="穿越像素森林的小路通向远山与金色太阳"
      /><span class="builder-world-label pixel-label">WORLD 02 / THE FOREST OF IDEAS</span><div
        class="builder-quote"
      >
        <p class="pixel-label">THERE IS ALWAYS ANOTHER WAY.</p><p>
          在模型能力与业务系统之间，<br />搭一座可靠的桥。
        </p>
      </div><PixelIcon kind="sword" class="forest-sword" />
    </div><div class="builder-copy">
      <p class="section-label">02 / MY INVENTORY</p><h2>
        技术是装备。<br />解决问题，<br /><span class="orange">才是主线。</span>
      </h2><div class="inventory-list">
        <div>
          <span class="inventory-number">01</span><div>
            <h3>AI & Agent Engineering</h3><p>从 Prompt 到工具调用，让模型能力变成可靠的工作流。</p>
          </div><span>↗</span>
        </div><div>
          <span class="inventory-number">02</span><div>
            <h3>Data & Business Context</h3><p>连接数据平台、BI 与投放分析，让答案有据可依。</p>
          </div><span>↗</span>
        </div><div>
          <span class="inventory-number">03</span><div>
            <h3>Automation & Open Source</h3><p>用工程消除重复，在真实系统与开源协作中持续进化。</p>
          </div><span>↗</span>
        </div>
      </div><a class="button cream-button" href={withBase('/about/')}>更多关于我 <span>↗</span></a><p
        class="pixel-label builder-footnote"
      >
        LESS HYPE. MORE THINGS THAT WORK.
      </p>
    </div>
  </section>
  <section class="writing-section">
    <div class="shell">
      <p class="section-label">03 / FIELD NOTES</p><div class="section-heading">
        <h2>探索会留下痕迹。<br /><span class="heading-subtle">把走过的路，写下来。</span></h2><a
          class="text-link"
          href={withBase('/writing/')}>翻开全部笔记 <span>↗</span></a>
      </div><div class="writing-layout">
        <div class="notebook-art" aria-hidden="true">
          <span class="pixel-label">THE EXPLORER’S JOURNAL</span><div class="pixel-notebook">
            <div class="notebook-spine"></div><PixelIcon /><span
              >FIELD<br />NOTES<span class="notebook-period">.</span></span
            ><small>IDEAS / LESSONS / LITTLE WINS</small>
          </div><span class="notebook-spark">✦</span><span class="notebook-caption pixel-label"
            >WRITE IT DOWN. KEEP MOVING.</span>
        </div><div class="post-list">
          {
            posts.map((post) => (
              <a class="post-row" href={withBase(`/writing/${post.id}/`)}>
                <>
                  <div class="post-meta">
                    <>
                      <time datetime={post.data.publishedAt.toISOString()}>
                        {date(post.data.publishedAt)}
                      </time>
                      <span>{post.data.tags[0]}</span>
                    </>
                  </div>
                  <div>
                    <>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.description}</p>
                    </>
                  </div>
                  <span class="post-arrow">↗</span>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
