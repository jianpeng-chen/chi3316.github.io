---
import { getCollection } from 'astro:content';
import PageScene from '../../components/PageScene.astro';
import { withBase } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const date = (value: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .format(value)
    .replaceAll('/', '.');
---

<BaseLayout title="文章" description="迟迟关于 AI 工程、Agent、数据平台、后端与开源实践的文章。">
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div><p class="section-label">WRITING / NOTES</p><h1>FIELD<br /><span>NOTES.</span></h1></div>
      <p class="lede">
        记录真实项目中的判断、失败和解决方案。内容从后端与开源工程出发，逐步延伸到 AI 应用、Agent 与数据产品。
      </p>
    </div>
  </section>
  <PageScene world="night" label="FIELD NOTES / KNOWLEDGE IS YOUR INVENTORY" />
  <section class="page-content">
    <div class="shell writing-index">
      <div class="search-panel" id="search" data-base-url={withBase('/')}>
        <div class="search-box">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg
          >
          <input
            id="search-input"
            aria-label="搜索文章"
            type="search"
            placeholder="搜索文章、技术或项目关键词…"
            autocomplete="off"
          />
        </div>
        <p class="search-hint">STATIC FULL-TEXT SEARCH · PRESS / TO FOCUS</p>
        <div class="search-results" id="search-results" aria-live="polite"></div>
      </div>
      <div class="writing-toolbar">
        <p><span id="visible-count">{posts.length}</span> 篇公开文章</p>
        <div class="filter-list">
          <button class="filter-button active" data-filter="all" aria-pressed="true">全部</button>
          {
            tags.map((tag) => (
              <button class="filter-button" data-filter={tag} aria-pressed="false">
                {tag}
              </button>
            ))
          }
        </div>
      </div>
      <div class="post-list" id="post-list">
        {
          posts.map((post) => (
            <a class="post-row" data-tags={post.data.tags.join('|')} href={withBase(`/writing/${post.id}/`)}>
              <time datetime={post.data.publishedAt.toISOString()}>{date(post.data.publishedAt)}</time>
              <div>
                <>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </>
              </div>
              <div class="tag-row">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <span>↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline type="module" src={withBase('/scripts/writing.js')}></script>
